# Set these in the Vercel project for Production and Preview before building.
# Backend URL must include the API base path (normally /api/v1).
# Cross-app URLs must be HTTPS origins without a path, query, or fragment.
# VITE_* values are public; do not enter credentials or private service URLs.
VITE_API_BASE_URL=
VITE_PORTAL_URL=
VITE_SHOW_DEV_TOOLS=false
VITE_USE_MOCK=false
