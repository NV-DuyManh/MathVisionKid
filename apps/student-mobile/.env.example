# MathVision Kids - Student Mobile Environment Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_USE_MOCK=false

# Student web sends verified Teacher/Admin accounts to their workspaces via SSO.
# Local development uses the same host on ports 5173/5174 when these are unset.
# Set both public HTTPS origins for a production web export.
# EXPO_PUBLIC_TEACHER_URL=https://teacher.your-domain.com
# EXPO_PUBLIC_ADMIN_URL=https://admin.your-domain.com
# EXPO_PUBLIC_PORTAL_URL=https://edu.your-domain.com

# Application Presentation Mode:
# MATHVISION_KIDS (default) - Full MathVision Kids math & handwriting app
# HAND_AI - Temporary Big Data Handwriting Recognition demo mode

