# MathVision Kids - Student Mobile Environment Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_USE_MOCK=false

# Google OAuth client IDs are public identifiers, not secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Application Presentation Mode:
# MATHVISION_KIDS (default) - Full MathVision Kids math & handwriting app
# HAND_AI - Temporary Big Data Handwriting Recognition demo mode

