{
  "expo": {
    "name": "MathVisionKid",
    "slug": "MathVisionKid",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/mathvision-icon-v2.png",
    "scheme": "mathvisionkid",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/mathvision-icon-v2.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6040DD",
        "foregroundImage": "./assets/illustrations/mathvision-star.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mathvision-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7FE",
          "image": "./assets/images/mathvision-icon-v2.png",
          "imageWidth": 164,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép MathVisionKid ghi âm câu hỏi khi em nhấn nói.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}