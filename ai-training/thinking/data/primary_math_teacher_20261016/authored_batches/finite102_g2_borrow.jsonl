{"sample_id":"primary_20261018_finite102_g2_borrow_mis_wrong_result","case_group_id":"primary_20261018_finite102_g2_borrow_mis_wrong_result","split":"train","grade":2,"topic":"mis_wrong_result","problem":"Cần tính 52 - 8. Bài viết giả định ghi: 52 - 8 = 56. Giữ câu viết, kiểm kết quả rồi tính lại bằng đổi chục.","givens":[{"id":"g0","text":"Ban đầu","value":"52","unit":"","role":"explicit_given_0"},{"id":"g1","text":"Bớt","value":"8","unit":"","role":"explicit_given_1"}],"requested_quantity":"Kiểm câu viết và sửa","student_work":{"text":"52 - 8 = 56.","observations":[{"excerpt":"52 - 8 = 56.","claim_scope":"Explicit synthetic written evidence only; no hidden reasoning or unseen image inferred."}]},"initial_guidance":["Xem phần đơn vị có đủ để bớt hay chưa."],"hints":[{"level":1,"hint":"Xem phần đơn vị có đủ để bớt hay chưa.","question":"Em nhận ra dữ kiện và quan hệ cần dùng như thế nào?"},{"level":2,"hint":"Đổi một chục thành các đơn vị thì phần chục phải giảm tương ứng.","question":"Em thực hiện theo quan hệ đó với đúng đơn vị ra sao?"},{"level":3,"hint":"Cộng hiệu với số trừ phải trở về số bị trừ.","question":"Em kiểm kết quả và đối chiếu điều được hỏi thế nào?"}],"worked_steps":[{"step_id":"s0","title":"Kiểm và sửa","reason":"Bớt số dương không thể cho kết quả lớn hơn số đầu.","result":"44","explanation":"56 lớn hơn 52 nên câu viết không đúng. 52 là 4 chục 12 đơn vị; 12 - 8 = 4, được 44. Kiểm 44 + 8 = 52. Không suy em đã thực hiện thao tác nào khác.","expression":"52-8","unit":""}],"expected_answer":[{"quantity":"Hiệu đúng","result":"44","unit":""}],"can_solve":true,"canonical_case":{"family":"mis_wrong_result","operations":[],"numeric_values":["52","8"]},"curriculum_assignment":{"node_id":"old_g2_subtraction_borrow","curriculum_scope":"LEGACY_OBSERVED_TOPIC_REFERENCE","case_kind":"misconception"},"provenance":{"authoring_method":"original_AI_teacher","authoring_label":"AI_GENERATED","authoring_agent":"root","human_verified":false,"teacher_certified":false,"inde