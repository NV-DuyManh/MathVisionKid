{"sample_id":"primary_20261018_finite102_g2_borrow_single_digit","case_group_id":"primary_20261018_finite102_g2_borrow_single_digit","split":"train","grade":2,"topic":"single_digit","problem":"Có 54 nhãn vở, dùng 7 nhãn, không thay đổi khác. Tìm số nhãn còn bằng đổi một chục rồi kiểm. ","givens":[{"id":"g0","text":"Có","value":"54","unit":"nhãn","role":"explicit_given_0"},{"id":"g1","text":"Dùng","value":"7","unit":"nhãn","role":"explicit_given_1"}],"requested_quantity":"Tính phần còn và kiểm","student_work":null,"initial_guidance":["Xem phần đơn vị có đủ để bớt hay chưa."],"hints":[{"level":1,"hint":"Xem phần đơn vị có đủ để bớt hay chưa.","question":"Em nhận ra dữ kiện và quan hệ cần dùng như thế nào?"},{"level":2,"hint":"Đổi một chục thành các đơn vị thì phần chục phải giảm tương ứng.","question":"Em thực hiện theo quan hệ đó với đúng đơn vị ra sao?"},{"level":3,"hint":"Cộng hiệu với số trừ phải trở về số bị trừ.","question":"Em kiểm kết quả và đối chiếu điều được hỏi thế nào?"}],"worked_steps":[{"step_id":"s0","title":"Đổi chục","reason":"4 đơn vị chưa đủ bớt 7 nên đổi một chục.","result":"14","explanation":"54 là 4 chục và 14 đơn vị; tổng vẫn là 54.","expression":"10+4","unit":"nhãn"},{"step_id":"s1","title":"Bớt và ghép","reason":"14 đơn vị bớt 7, còn phần 4 chục.","result":"47","explanation":"14 - 7 = 7; 40 + 7 = 47 nhãn. Kiểm 47 + 7 = 54.","expression":"40+(14-7)","unit":"nhãn"}],"expected_answer":[{"quantity":"Nhãn còn","result":"47","unit":"nhãn"}],"can_solve":true,"canonical_case":{"family":"single_digit","operations":[],"numeric_values":["54","7"]},"curriculum_assignment":{"node_id":"old_g2_subtraction_borrow","curriculum_scope":"LEGACY_OBSERVED_TOPIC_REFERENCE","case_kind":"core","case_slot":"core_01","context_variant":"canonical_explicit_data","method_variant":"explain_rule_then_apply"},"provenance":{"authoring_method":"original_AI_teacher","authoring_label":"AI_GENERATED","authoring_agent":"root","human_verified":false,"teacher_certified":false,"indep