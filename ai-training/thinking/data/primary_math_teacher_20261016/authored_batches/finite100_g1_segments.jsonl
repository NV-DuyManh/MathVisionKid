{"sample_id":"primary_20261018_finite100_g1_segments_nonzero_record","case_group_id":"primary_20261018_finite100_g1_segments_nonzero_record","split":"train","grade":1,"topic":"nonzero_record","problem":"Một bản mô tả vẽ đoạn CD ghi C tại vạch 3 cm, D tại vạch 9 cm trên thước thẳng, hai điểm cùng cạnh thước. Hỏi đoạn theo mô tả dài bao nhiêu và có đúng yêu cầu 6 cm không? Chưa có ảnh thực tế.","givens":[{"id":"g0","text":"Vạch C","value":"3","unit":"cm","role":"explicit_given_0"},{"id":"g1","text":"Vạch D","value":"9","unit":"cm","role":"explicit_given_1"},{"id":"g2","text":"Yêu cầu","value":"6","unit":"cm","role":"explicit_given_2"}],"requested_quantity":"Tìm độ dài theo bản ghi, đối chiếu yêu cầu","student_work":null,"initial_guidance":["Độ dài đoạn được kiểm giữa hai đầu, không chỉ bằng nhãn số ở một đầu."],"hints":[{"level":1,"hint":"Độ dài đoạn được kiểm giữa hai đầu, không chỉ bằng nhãn số ở một đầu.","question":"Em xác định hai đầu và vạch thước tương ứng thế nào?"},{"level":2,"hint":"Thước thẳng, đúng đơn vị và các vạch đều giúp lấy khoảng cách giữa hai đầu.","question":"Em đánh dấu rồi nối hoặc đối chiếu các khoảng đơn vị ra sao?"},{"level":3,"hint":"Cần đo lại từ đầu này đến đầu kia sau khi nối.","question":"Em kiểm độ dài và vị trí hai đầu thế nào?"}],"worked_steps":[{"step_id":"s0","title":"Tìm khoảng giữa hai đầu","reason":"Vạch đầu không phải không nên lấy hiệu.","result":"6","explanation":"9 - 3 = 6 cm; kiểm 3 + 6 = 9. Không lấy nhãn 9 làm chiều dài.","expression":"9-3","unit":"cm"},{"step_id":"s1","title":"Đối chiếu","reason":"Số đo tính từ bản ghi bằng yêu cầu.","result":"Bản mô tả phù hợp yêu cầu độ dài","explanation":"Vẫn cần ảnh rõ hoặc đo thực tế để xác nhận đoạn thật.","expression":null,"unit":""}],"expected_answer":[{"quantity":"Độ dài CD","result":"6","unit":"cm"}],"can_solve":true,"canonical_case":{"family":"nonzero_record","operations":["9-3"],"numeric_values":["3","9","6"]},"curriculum_assignment":{"node_id":"old_g1_draw_segment","curriculu