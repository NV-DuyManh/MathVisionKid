{"sample_id":"primary_20261018_finite100_g1_segments_two_origins_same_length","case_group_id":"primary_20261018_finite100_g1_segments_two_origins_same_length","split":"train","grade":1,"topic":"two_origins_same_length","problem":"Hai kế hoạch vẽ đoạn 5 cm: A đánh dấu ở vạch 0 và 5 cm; B ở vạch 2 và 7 cm, thước thẳng, vạch đều. Hãy kiểm hai kế hoạch và giải thích vì sao không nhất thiết bắt đầu cùng vạch; chưa có hình thật.","givens":[{"id":"g0","text":"A đầu","value":"0","unit":"cm","role":"explicit_given_0"},{"id":"g1","text":"A cuối","value":"5","unit":"cm","role":"explicit_given_1"},{"id":"g2","text":"B đầu","value":"2","unit":"cm","role":"explicit_given_2"},{"id":"g3","text":"B cuối","value":"7","unit":"cm","role":"explicit_given_3"}],"requested_quantity":"Kiểm độ dài hai kế hoạch và giải thích mốc","student_work":null,"initial_guidance":["Độ dài đoạn được kiểm giữa hai đầu, không chỉ bằng nhãn số ở một đầu."],"hints":[{"level":1,"hint":"Độ dài đoạn được kiểm giữa hai đầu, không chỉ bằng nhãn số ở một đầu.","question":"Em xác định hai đầu và vạch thước tương ứng thế nào?"},{"level":2,"hint":"Thước thẳng, đúng đơn vị và các vạch đều giúp lấy khoảng cách giữa hai đầu.","question":"Em đánh dấu rồi nối hoặc đối chiếu các khoảng đơn vị ra sao?"},{"level":3,"hint":"Cần đo lại từ đầu này đến đầu kia sau khi nối.","question":"Em kiểm độ dài và vị trí hai đầu thế nào?"}],"worked_steps":[{"step_id":"s0","title":"Kiểm A","reason":"Khoảng đo bằng hiệu hai vạch.","result":"5","explanation":"5 - 0 = 5 cm; năm khoảng cm.","expression":"5-0","unit":"cm"},{"step_id":"s1","title":"Kiểm B","reason":"Đổi mốc đầu không đổi số khoảng khi hai đầu cùng dịch.","result":"5","explanation":"7 - 2 = 5 cm; kiểm 2 + 5 = 7. Cả hai kế hoạch có độ dài đúng, không xác nhận thao tác thật.","expression":"7-2","unit":"cm"}],"expected_answer":[{"quantity":"Độ dài mỗi kế hoạch","result":"5","unit":"cm"}],"can_solve":true,"canonical_case":{"family":"two_origins_same_length","operations":["5-0","7-2"],"