{"sample_id":"primary_20261016_g1_foundations_0002_same_tens","split":"train","case_group_id":"primary_20261016_g1_foundations_0002_same_tens","grade":1,"topic":"compare_two_natural_numbers_same","problem":"Hai thẻ ghi số 62 và 68. Thẻ nào ghi số lớn hơn? Giải thích bằng hàng chục và hàng đơn vị.","givens":[{"id":"g0","text":"62","value":"62","unit":"","role":"first_number"},{"id":"g1","text":"68","value":"68","unit":"","role":"second_number"}],"requested_quantity":"Số lớn hơn","student_work":null,"initial_guidance":["Cả hai thẻ đều ghi số có hai chữ số.","So hàng chục trước; nếu bằng nhau mới so hàng đơn vị."],"hints":[{"level":1,"hint":"Kiểm tra hai chữ số hàng chục trước.","question":"Hai số có cùng số chục hay khác số chục?"},{"level":2,"hint":"Khi hàng chục bằng nhau, chuyển sang hàng đơn vị.","question":"Em cần so sánh hai chữ số ở hàng nào tiếp theo?"},{"level":3,"hint":"Giữ nguyên số chục bằng nhau và chọn số có nhiều đơn vị hơn.","question":"Lựa chọn của em có phù hợp với cách xếp hai số trên tia số không?"}],"worked_steps":[{"title":"So sánh theo giá trị các hàng","reason":"Hai số có cùng số chục, nên dùng hàng đơn vị để phân biệt.","expression":"68","result":"68","unit":"","explanation":"62 và 68 đều có 6 chục. So hàng đơn vị: 2 ít hơn 8. Vì thế 62 bé hơn 68, nên chọn 68.","step_id":"s0"}],"expected_answer":[{"quantity":"Số lớn hơn","result":"68","unit":""}],"canonical_case":{"family":"compare_two_natural_numbers_same","operations":["68"],"numeric_values":["62","68"]},"curriculum_assignment":{"node_id":"current_g1_compare_order_100","curriculum_scope":"CURRENT_2018_OUTCOME_REFERENCE","case_kind":"core","case_slot":"core_02","context_variant":"contrast_representation_or_boundary","method_variant":"contrast_or_second_valid_method_if_age_appropriate"},"provenance":{"authoring_method":"original_AI_teacher","human_verified":false,"teacher_certified":false,"curriculum_node_id":"current_g1_compare_order_100","source_kind":"original_explicit_text_teacher_case","s