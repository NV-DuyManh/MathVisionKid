{"sample_id":"primary_20261016_g1_foundations_0002_five_tens","split":"train","case_group_id":"primary_20261016_g1_foundations_0002_five_tens","grade":1,"topic":"same_quantity_tens_and_units","problem":"Có 5 bó que, mỗi bó có mười que, tức một chục que. Viết lượng que bằng số chục và bằng số que; giải thích hai cách viết.","givens":[{"id":"g0","text":"5 bó que","value":"5","unit":"bó","role":"bundle_count"},{"id":"g1","text":"mỗi bó có mười que","value":"10","unit":"que/bó","role":"tens_bundle_size"}],"requested_quantity":"Lượng que tính theo chục; Lượng que tính theo đơn vị","student_work":null,"initial_guidance":["Giữ nguyên các que, chỉ đổi cách gọi đơn vị đếm.","Mỗi bó là một chục; có thể đếm các bó trước khi đếm từng que."],"hints":[{"level":1,"hint":"Hãy nhìn các bó như các nhóm một chục.","question":"Khi đếm bó, em đang đếm từng que hay từng chục?"},{"level":2,"hint":"Đếm tiếp mỗi lần một chục thay vì mở các bó.","question":"Một chục có bao nhiêu que theo đề?"},{"level":3,"hint":"Viết cách đếm theo chục rồi đổi cùng lượng đó sang đơn vị que.","question":"Vì sao hai cách viết khác đơn vị mà vẫn nói về cùng các que?"}],"worked_steps":[{"title":"Đếm theo chục","reason":"Mỗi bó là một chục; đếm năm bó theo đơn vị chục.","expression":"5","result":"5","unit":"chục","explanation":"Một chục, hai chục, ba chục, bốn chục, năm chục. Có năm chục que.","step_id":"s0"},{"title":"Đổi cách biểu diễn cùng lượng","reason":"Mỗi chục gồm mười đơn vị, nên đếm tiếp từng chục bằng số đơn vị.","expression":"10+10+10+10+10","result":"50","unit":"que","explanation":"Đếm theo chục: 10, 20, 30, 40, 50. Năm chục que cũng là 50 que; lượng que không thay đổi.","step_id":"s1"}],"expected_answer":[{"quantity":"Lượng que tính theo chục","result":"5","unit":"chục"},{"quantity":"Lượng que tính theo đơn vị","result":"50","unit":"que"}],"canonical_case":{"family":"same_quantity_tens_and_units","operations":["10+10+10+10+10"],"numeric_values":["5","10"]},"curriculum_assignment":{"node_id":"current_g1_natural_numbers_100","curriculum_scope":"CURRENT_2018_OUTCOME_REFERENCE","case_kind":"core","case_slot":"core_03","context_variant":"transfer_withindomain","method_variant":"apply_then_independently_check"},"provenance":{"authoring_method":"original_AI_teacher","human_verified":false,"teacher_certified":false,"curriculum_node_id":"current_g1_natural_numbers_100","source_kind":"original_explicit_text_teacher_case","source_evidence":{"registry_path":"thinking/data/teacher_math_v3/curriculum_sources.json","registry_sha256":"81bcff6a7282a2c1eb540ca65ec27855e0e79ecaa6d5af226c6dae80973f336a","source_id":"math_2018_annex","source_url":"https://storage-vnportal.vnpt.vn/edu-vtu/4803/2023/Thongtu32/3.-chuong-trinh-mon-toan.pdf","source_payload_sha256":"f35d34ff84da2ca3f9ab72d5d67482ada414684b611deea98c4b329801b661ab","source_locator":[21,22],"verification_status":"primary_annex_outcome_read","evidence_previously_read_on":"2026-10-13","refetched_or_legal_recertified_20261016":false,"original_2006_annex_verified":false,"current_2026_legal_currency_certified":false,"status":"2018_ANNEX_OUTCOME_READ_CURRENT_LEGAL_CONSOLIDATION_PENDING","limitations":[]},"blueprint_sha256":"c0fa09d55b29b86cdaae01d25fad1952f64df7b48c721c382043c6391ca2f8f7","benchmark_status":"TRAINING_ONLY_NOT_GOLD","real_observation_claim":false,"bounded_numeric_exposure":"NO_DETECTED_PREVIOUS_TRAIN_SIGNATURE","previous_train_source_ids":[]},"quality_flags":{"app_plan_draft_compatible":false,"app_mapping_status":"NEUTRAL_TEACHER_SCHEMA_REQUIRES_ADAPTER","full_worked_solution_requires_explicit_request":true,"three_hint_levels_answer_free":true}}
{"sample_id":"primary_20261016_g1_foundations_0002_different_tens","split":"train","case_group_id":"primary_20261016_g1_foundations_0002_different_tens","grade":1,"topic":"compare_two_natural_numbers_different","problem":"Hai thẻ ghi số 46 và 73. Thẻ nào ghi số lớn hơn? Giải thích bằng hàng chục và hàng đơn vị.","givens":[{"id":"g0","text":"46","value":"46","unit":"","role":"first_number"},{"id":"g1","text":"73","value":"73","unit":"","role":"second_number"}],"requested_quantity":"Số lớn hơn","student_work":null,"initial_guidance":["Cả hai thẻ đều ghi số có hai chữ số.","So hàng chục trước; nếu bằng nhau mới so hàng đơn vị."],"hints":[{"level":1,"hint":"Xét hàng chục trước, chưa vội so hàng đơn vị.","question":"Chữ số hàng chục nằm ở vị trí nào trong mỗi số?"},{"level":2,"hint":"Đọc số chục của từng thẻ.","question":"Nếu số chục khác nhau, em cần so sánh hàng nào?"},{"level":3,"hint":"Dựa vào số chục để chọn số lớn hơn; hàng đơn vị chỉ xét khi hàng chục bằng nhau.","question":"Vì sao một chữ số đơn vị lớn hơn chưa đủ quyết định cả số lớn hơn?"}],"worked_steps":[{"title":"So sánh theo giá trị các hàng","reason":"Hai số có hàng chục khác nhau; số có nhiều chục hơn lớn hơn.","expression":"73","result":"73","unit":"","explanation":"46 có 4 chục, 73 có 7 chục. Bốn chục ít hơn bảy chục; không cần dùng hàng đơn vị để đổi kết luận. Số lớn hơn là 73.","step_id":"s0"}],"expected_answer":[{"quantity":"Số lớn hơn","result":"73","unit":""}],"canonical_case":{"family":"compare_two_natural_numbers_different","operations":["73"],"numeric_values":["46","73"]},"curriculum_assignment":{"node_id":"current_g1_compare_order_100","curriculum_scope":"CURRENT_2018_OUTCOME_REFERENCE","case_kind":"core","case_slot":"core_01","context_variant":"canonical_explicit_data","method_variant":"explain_rule_then_apply"},"provenance":{"authoring_method":"original_AI_teacher","human_verified":false,"teacher_certified":false,"curriculum_node_id":"current_g1_compare_order_100","source_kind":"original_expl