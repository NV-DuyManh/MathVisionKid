{"sample_id":"primary_20261016_g1_foundations_0002_sort_four","split":"train","case_group_id":"primary_20261016_g1_foundations_0002_sort_four","grade":1,"topic":"order_four_natural_numbers","problem":"Xếp bốn số 58, 25, 52, 8 theo thứ tự từ bé đến lớn. Hãy kiểm tra từng cặp đứng cạnh nhau.","givens":[{"id":"g0","text":"58","value":"58","unit":"","role":"number_to_order"},{"id":"g1","text":"25","value":"25","unit":"","role":"number_to_order"},{"id":"g2","text":"52","value":"52","unit":"","role":"number_to_order"},{"id":"g3","text":"8","value":"8","unit":"","role":"number_to_order"}],"requested_quantity":"Dãy số từ bé đến lớn","student_work":null,"initial_guidance":["Có đúng bốn số cần xếp; mỗi số chỉ xuất hiện một lần trong đáp án.","Chiều yêu cầu là từ bé đến lớn, nên xét số bé nhất trước."],"hints":[{"level":1,"hint":"Phân biệt số có một chữ số với số có hai chữ số.","question":"Số nào thuộc nhóm một chữ số trong danh sách?"},{"level":2,"hint":"Trong nhóm hai chữ số, so hàng chục rồi mới so hàng đơn vị nếu cần.","question":"Khi hai số có cùng số chục, em sẽ dùng hàng nào để xếp chúng?"},{"level":3,"hint":"Sau khi xếp, đọc từng cặp liền nhau và giữ nguyên đủ bốn số của đề.","question":"Có cặp nào đứng trước lại lớn hơn số đứng sau không?"}],"worked_steps":[{"title":"Tìm số bé nhất","reason":"Số một chữ số bé hơn các số hai chữ số trong danh sách.","expression":"8","result":"8","unit":"","explanation":"Số 8 có một chữ số; các số còn lại đều lớn hơn một chục. Đặt 8 trước.","step_id":"s0"},{"title":"Xếp các số hai chữ số","reason":"So hàng chục; nếu bằng nhau thì so hàng đơn vị.","expression":null,"result":"25 < 52 < 58","unit":"","explanation":"25 có 2 chục, đứng trước hai số có 5 chục. Giữa 52 và 58, cùng 5 chục nhưng 2 đơn vị ít hơn 8 đơn vị, nên 52 đứng trước 58.","step_id":"s1"},{"title":"Viết thứ tự và kiểm lại","reason":"Đọc lại các cặp liền nhau để chắc rằng mỗi số đứng trước đều bé hơn số sau.","expression":null,"result":"8, 25, 52, 58","unit":"","explanation":"Thứ tự là 8, 25, 52, 58. Kiểm tra: 8 < 25, 25 < 52 và 52 < 58.","step_id":"s2"}],"expected_answer":[{"quantity":"Dãy số từ bé đến lớn","result":"8, 25, 52, 58","unit":""}],"canonical_case":{"family":"order_four_natural_numbers","operations":[],"numeric_values":["58","25","52","8"]},"curriculum_assignment":{"node_id":"current_g1_compare_order_100","curriculum_scope":"CURRENT_2018_OUTCOME_REFERENCE","case_kind":"core","case_slot":"core_03","context_variant":"transfer_withindomain","method_variant":"apply_then_independently_check"},"provenance":{"authoring_method":"original_AI_teacher","human_verified":false,"teacher_certified":false,"curriculum_node_id":"current_g1_compare_order_100","source_kind":"original_explicit_text_teacher_case","source_evidence":{"registry_path":"thinking/data/teacher_math_v3/curriculum_sources.json","registry_sha256":"81bcff6a7282a2c1eb540ca65ec27855e0e79ecaa6d5af226c6dae80973f336a","source_id":"math_2018_annex","source_url":"https://storage-vnportal.vnpt.vn/edu-vtu/4803/2023/Thongtu32/3.-chuong-trinh-mon-toan.pdf","source_payload_sha256":"f35d34ff84da2ca3f9ab72d5d67482ada414684b611deea98c4b329801b661ab","source_locator":[21,22],"verification_status":"primary_annex_outcome_read","evidence_previously_read_on":"2026-10-13","refetched_or_legal_recertified_20261016":false,"original_2006_annex_verified":false,"current_2026_legal_currency_certified":false,"status":"2018_ANNEX_OUTCOME_READ_CURRENT_LEGAL_CONSOLIDATION_PENDING","limitations":[]},"blueprint_sha256":"c0fa09d55b29b86cdaae01d25fad1952f64df7b48c721c382043c6391ca2f8f7","benchmark_status":"TRAINING_ONLY_NOT_GOLD","real_observation_claim":false,"bounded_numeric_exposure":"NO_DETECTED_PREVIOUS_TRAIN_SIGNATURE","previous_train_source_ids":[]},"quality_flags":{"app_plan_draft_compatible":false,"app_mapping_status":"NEUTRAL_TEACHER_SCHEMA_REQUIRES_ADAPTER","full_worked_solution_requires_explicit_request":true,"three_hint_levels_answer_free":true}}
{"sample_id":"primary_20261016_g1_foundations_0002_mental_within10","split":"train","case_group_id":"primary_20261016_g1_foundations_0002_mental_within10","grade":1,"topic":"mental_join_within10","problem":"Lan có 6 hạt đậu và được cho thêm 3 hạt. Hãy nhẩm số hạt của Lan và nói cách đếm tiếp.","givens":[{"id":"g0","text":"6 hạt đậu","value":"6","unit":"hạt","role":"initial_count"},{"id":"g1","text":"thêm 3 hạt","value":"3","unit":"hạt","role":"added_count"}],"requested_quantity":"Số hạt của Lan","student_work":null,"initial_guidance":["Số hạt đang có đã biết; em có thể bắt đầu từ số đó.","Mỗi hạt thêm ứng với một lần đếm tiếp."],"hints":[{"level":1,"hint":"Giữ số đang có trong đầu thay vì đếm lại tất cả từ đầu.","question":"Sau khi được cho thêm, số hạt tăng hay giảm?"},{"level":2,"hint":"Đếm tiếp đúng số lần bằng số hạt được thêm.","question":"Em làm cách nào để nhớ mình đã đếm thêm đủ số lần?"},{"level":3,"hint":"Dừng sau khi đã đếm hết phần thêm và ghi đúng đơn vị.","question":"Số cuối khi đếm tiếp cho em biết đại lượng nào?"}],"worked_steps":[{"title":"Đếm tiếp phần được thêm","reason":"Thêm vào là gộp lượng mới với lượng đang có; không phải đếm lại từ đầu.","expression":"6+3","result":"9","unit":"hạt","explanation":"Giữ 6 trong đầu, đếm thêm ba lần: 7, 8, 9. Lan có 9 hạt; 6 + 3 = 9.","step_id":"s0"}],"expected_answer":[{"quantity":"Số hạt của Lan","result":"9","unit":"hạt"}],"canonical_case":{"family":"mental_join_within10","operations":["6+3"],"numeric_values":["6","3"]},"curriculum_assignment":{"node_id":"current_g1_mental_add_sub","curriculum_scope":"CURRENT_2018_OUTCOME_REFERENCE","case_kind":"core","case_slot":"core_01","context_variant":"canonical_explicit_data","method_variant":"explain_rule_then_apply"},"provenance":{"authoring_method":"original_AI_teacher","human_verified":false,"teacher_certified":false,"curriculum_node_id":"current_g1_mental_add_sub","source_kind":"original_explicit_text_teacher_case","source_evidence":{"registry_path":"thinking/data