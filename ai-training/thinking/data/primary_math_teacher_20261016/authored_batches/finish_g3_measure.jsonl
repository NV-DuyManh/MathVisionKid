{"sample_id":"primary_20261018_finish_g3_measure_broken_ruler_plan","case_group_id":"primary_20261018_finish_g3_measure_broken_ruler_plan","split":"train","grade":3,"topic":"broken_ruler_plan","problem":"Một thước thẳng giả định bị mờ vạch 0 nhưng các vạch cm từ 4 đến 25 rõ và cách đều. Đặt dây thẳng dọc thước: một đầu ở 4 cm, đầu kia ở 23 cm. Tìm chiều dài và nêu cách kiểm bằng thước nguyên vạch 0.","givens":[{"id":"g0","text":"Mốc đầu","value":"4","unit":"cm","role":"explicit_given_0"},{"id":"g1","text":"Mốc cuối","value":"23","unit":"cm","role":"explicit_given_1"}],"requested_quantity":"Tính chiều dài theo bản ghi và nêu cách kiểm đo.","student_work":null,"initial_guidance":["Đây là bản ghi hoặc kế hoạch giả định; xác định dụng cụ, đơn vị và hai mốc của vật."],"hints":[{"level":1,"hint":"Đây là bản ghi hoặc kế hoạch giả định; xác định dụng cụ, đơn vị và hai mốc của vật.","question":"Em nhận ra dữ kiện và quan hệ cần dùng như thế nào?"},{"level":2,"hint":"Nếu vật không bắt đầu ở vạch không, lấy mốc cuối bớt mốc đầu; giữ thước thẳng theo vật.","question":"Em thực hiện theo quan hệ đó với đúng đơn vị ra sao?"},{"level":3,"hint":"Đặt lại đầu vật ở vạch không hoặc đo lại theo cùng đơn vị để kiểm; chưa khẳng định đã thao tác thật.","question":"Em kiểm kết quả và đối chiếu điều được hỏi thế nào?"}],"worked_steps":[{"step_id":"s0","title":"Dùng phần thước rõ","reason":"Khoảng cách vẫn đọc được từ hai mốc rõ cùng đơn vị.","result":"19","explanation":"23-4=19; có thể đặt đầu dây ở 0 của thước nguyên rồi đọc đầu kia. Đó là kế hoạch kiểm, chưa phải kết quả đo thật.","expression":"23-4","unit":"cm"}],"expected_answer":[{"quantity":"Chiều dài theo bản ghi","result":"19","unit":"cm"}],"can_solve":true,"canonical_case":{"family":"broken_ruler_plan","operations":[],"numeric_values":["4","23"]},"curriculum_assignment":{"node_id":"old_g3_measure_length","curriculum_scope":"LEGACY_OBSERVED_TOPIC_REFERENCE","case_kind":"core","case_slot":"core_03","context_variant":"transfer_withindo