{"sample_id":"primary_20261018_finish_g3_measure_ruler_nonzero_record","case_group_id":"primary_20261018_finish_g3_measure_ruler_nonzero_record","split":"train","grade":3,"topic":"ruler_nonzero_record","problem":"Trong bản ghi đo giả định, bút thẳng đặt dọc thước chia xăng-ti-mét, hai đầu trùng vạch 3 cm và 16 cm, không lệch thước. Tìm chiều dài bút từ bản ghi.","givens":[{"id":"g0","text":"Mốc đầu","value":"3","unit":"cm","role":"explicit_given_0"},{"id":"g1","text":"Mốc cuối","value":"16","unit":"cm","role":"explicit_given_1"}],"requested_quantity":"Tìm chiều dài bút theo bản ghi đo.","student_work":null,"initial_guidance":["Đây là bản ghi hoặc kế hoạch giả định; xác định dụng cụ, đơn vị và hai mốc của vật."],"hints":[{"level":1,"hint":"Đây là bản ghi hoặc kế hoạch giả định; xác định dụng cụ, đơn vị và hai mốc của vật.","question":"Em nhận ra dữ kiện và quan hệ cần dùng như thế nào?"},{"level":2,"hint":"Nếu vật không bắt đầu ở vạch không, lấy mốc cuối bớt mốc đầu; giữ thước thẳng theo vật.","question":"Em thực hiện theo quan hệ đó với đúng đơn vị ra sao?"},{"level":3,"hint":"Đặt lại đầu vật ở vạch không hoặc đo lại theo cùng đơn vị để kiểm; chưa khẳng định đã thao tác thật.","question":"Em kiểm kết quả và đối chiếu điều được hỏi thế nào?"}],"worked_steps":[{"step_id":"s0","title":"Lấy khoảng cách mốc","reason":"Chiều dài là khoảng giữa hai mốc, không phải chỉ số vạch cuối.","result":"13","explanation":"Từ 3 đến 16 có 13 khoảng 1 cm;13+3=16. Đây là dữ liệu giả định, chưa xác nhận đo thật.","expression":"16-3","unit":"cm"}],"expected_answer":[{"quantity":"Chiều dài bút","result":"13","unit":"cm"}],"can_solve":true,"canonical_case":{"family":"ruler_nonzero_record","operations":[],"numeric_values":["3","16"]},"curriculum_assignment":{"node_id":"old_g3_measure_length","curriculum_scope":"LEGACY_OBSERVED_TOPIC_REFERENCE","case_kind":"core","case_slot":"core_01","context_variant":"canonical_explicit_data","method_variant":"explain_rule_then_apply"},"provenance":{"authori