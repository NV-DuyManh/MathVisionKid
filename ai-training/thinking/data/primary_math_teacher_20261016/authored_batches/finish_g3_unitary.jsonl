{"sample_id":"primary_20261018_finish_g3_unitary_same_price_pens","case_group_id":"primary_20261018_finish_g3_unitary_same_price_pens","split":"train","grade":3,"topic":"same_price_pens","problem":"Mua 5 chiếc bút cùng loại, cùng đơn giá hết 35000 đồng, không phí hay giảm giá. Hỏi 3 chiếc cùng loại và cùng đơn giá đó hết bao nhiêu đồng.","givens":[{"id":"g0","text":"Số bút đã mua","value":"5","unit":"chiếc","role":"explicit_given_0"},{"id":"g1","text":"Tiền đã trả","value":"35000","unit":"đồng","role":"explicit_given_1"},{"id":"g2","text":"Số bút cần mua","value":"3","unit":"chiếc","role":"explicit_given_2"}],"requested_quantity":"Tìm tiền mua số bút cần mua qua đơn giá.","student_work":null,"initial_guidance":["Xác định các phần có thật sự bằng nhau hoặc cùng đơn giá không."],"hints":[{"level":1,"hint":"Xác định các phần có thật sự bằng nhau hoặc cùng đơn giá không.","question":"Em nhận ra dữ kiện và quan hệ cần dùng như thế nào?"},{"level":2,"hint":"Tìm lượng ứng với một phần trước, rồi nhân số phần cần tìm hoặc chia tổng cần xếp.","question":"Em thực hiện theo quan hệ đó với đúng đơn vị ra sao?"},{"level":3,"hint":"Kiểm bằng cách tái tạo lượng được cho; không áp dụng cùng đơn vị nếu đề chưa bảo đảm các phần bằng nhau.","question":"Em kiểm kết quả và đối chiếu điều được hỏi thế nào?"}],"worked_steps":[{"step_id":"s0","title":"Tìm tiền một bút","reason":"Các bút cùng đơn giá nên chia tổng tiền cho số bút.","result":"7000","explanation":"7000*5=35000 tái tạo hóa đơn.","expression":"35000/5","unit":"đồng"},{"step_id":"s1","title":"Tìm tiền cần trả","reason":"Mỗi bút vẫn cùng đơn giá nên nhân với số bút cần.","result":"21000","explanation":"21000:3=7000; không dùng tổng tiền ban đầu làm giá một bút.","expression":"{s0}*3","unit":"đồng"}],"expected_answer":[{"quantity":"Tiền mua bút","result":"21000","unit":"đồng"}],"can_solve":true,"canonical_case":{"family":"same_price_pens","operations":[],"numeric_values":["5","35000","3"]},"curriculum_assignment":{"node_id":"old_g