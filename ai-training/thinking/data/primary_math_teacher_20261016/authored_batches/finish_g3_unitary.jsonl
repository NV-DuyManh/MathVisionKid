{"sample_id":"primary_20261018_finish_g3_unitary_unit_mass_inverse_bag_count","case_group_id":"primary_20261018_finish_g3_unitary_unit_mass_inverse_bag_count","split":"train","grade":3,"topic":"unit_mass_inverse_bag_count","problem":"Bốn bao gạo chứa bằng nhau, tổng 36 kg. Muốn xếp 63 kg gạo vào các bao có khối lượng gạo bằng mỗi bao đã nêu, xếp vừa hết. Cần bao nhiêu bao.","givens":[{"id":"g0","text":"Số bao mẫu","value":"4","unit":"bao","role":"explicit_given_0"},{"id":"g1","text":"Tổng gạo mẫu","value":"36","unit":"kg","role":"explicit_given_1"},{"id":"g2","text":"Tổng cần xếp","value":"63","unit":"kg","role":"explicit_given_2"}],"requested_quantity":"Tìm số bao cần qua khối lượng một bao.","student_work":null,"initial_guidance":["Xác định các phần có thật sự bằng nhau hoặc cùng đơn giá không."],"hints":[{"level":1,"hint":"Xác định các phần có thật sự bằng nhau hoặc cùng đơn giá không.","question":"Em nhận ra dữ kiện và quan hệ cần dùng như thế nào?"},{"level":2,"hint":"Tìm lượng ứng với một phần trước, rồi nhân số phần cần tìm hoặc chia tổng cần xếp.","question":"Em thực hiện theo quan hệ đó với đúng đơn vị ra sao?"},{"level":3,"hint":"Kiểm bằng cách tái tạo lượng được cho; không áp dụng cùng đơn vị nếu đề chưa bảo đảm các phần bằng nhau.","question":"Em kiểm kết quả và đối chiếu điều được hỏi thế nào?"}],"worked_steps":[{"step_id":"s0","title":"Tìm mỗi bao","reason":"Các bao mẫu bằng nhau nên chia để về một bao.","result":"9","explanation":"9*4=36 kg, khớp mẫu.","expression":"36/4","unit":"kg"},{"step_id":"s1","title":"Tìm số bao","reason":"Đếm số phần khối lượng bằng một bao trong tổng cần xếp.","result":"7","explanation":"7*9=63 kg, xếp vừa hết.","expression":"63/{s0}","unit":"bao"}],"expected_answer":[{"quantity":"Số bao cần","result":"7","unit":"bao"}],"can_solve":true,"canonical_case":{"family":"unit_mass_inverse_bag_count","operations":[],"numeric_values":["4","36","63"]},"curriculum_assignment":{"node_id":"old_g3_unitary_word_problems","curriculum_scope"