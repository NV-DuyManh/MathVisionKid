root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.py]
indent_size = 4

[{*.bat,*.cmd,*.ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# Frozen research evidence must retain its original bytes.
[report/OCR_*.md]
trim_trailing_whitespace = false
insert_final_newline = false
