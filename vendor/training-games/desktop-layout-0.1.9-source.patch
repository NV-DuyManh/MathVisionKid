diff --git a/src/games/race-to-finish/tests/cameraGeometry.test.ts b/src/games/race-to-finish/tests/cameraGeometry.test.ts
index baaf054..ce63435 100644
--- a/src/games/race-to-finish/tests/cameraGeometry.test.ts
+++ b/src/games/race-to-finish/tests/cameraGeometry.test.ts
@@ -20,0 +21,10 @@ test.each([[640, 360], [780, 360], [800, 360], [960, 432], [1280, 720], [360, 80
+test('desktop overview fits on either side of 1000px while touch retains focus zoom', () => {
+  for (const width of [999, 1000]) {
+    const overview = fitToBoard(width, 720, true);
+    expect(overview.zoom).toBe(overview.fit);
+    expect(overview.worldWidth * overview.zoom).toBeCloseTo(width);
+    expect(overview.worldHeight * overview.zoom).toBeCloseTo(720);
+    expect(fitToBoard(width, 720).zoom).toBeGreaterThan(overview.zoom);
+  }
+});
