# Keep AI service source reviewable; exclude local artifacts, datasets and model weights.
ai/runtime/*
!ai/runtime/app/
!ai/runtime/tests/
ai/runtime/tests/**
!ai/runtime/tests/**/
!ai/runtime/tests/**/*.py
!ai/runtime/tests/fixtures/**/*.json
!ai/runtime/tests/fixtures/real_hw/OWNER_POEM_12_LINES.png
!ai/runtime/models/
ai/runtime/models/**
!ai/runtime/models/**/
!ai/runtime/models/**/*.json
!ai/runtime/models/**/*.yaml
!ai/runtime/evaluation/
!ai/runtime/scripts/
!ai/runtime/.env.example
!ai/runtime/Dockerfile
!ai/runtime/.dockerignore
!ai/runtime/README.md
!ai/runtime/pyproject.toml
!ai/runtime/requirements.txt
!ai/runtime/requirements-lock.txt
!ai/runtime/uv.lock

# Environment files (preserve .env.example)
.env*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*.env.local

