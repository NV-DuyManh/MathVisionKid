# Private server configuration: copy to .env.production and chmod 600.
# This is not a Vite environment file. No secrets belong in VITE_* variables.
API_DOMAIN=api.example.com
CADDY_EMAIL=
CORS_ALLOWED_ORIGINS=https://portal.example.com,https://teacher.example.com,https://admin.example.com
MODEL_BUNDLE_DIR=/srv/mathvision/models

# Generate independent random secrets (hex avoids Redis URL-escaping problems).
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
MINIO_ACCESS_KEY=mathvision-storage
MINIO_SECRET_KEY=

# Enable once on an empty database, then disable and remove the password.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Owner

# Copy the intended provider settings into the server secret store.
GROQ_ENABLED=true
GROQ_API_KEYS=
GROQ_PRIMARY_VISION_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_VISION_MODEL=qwen/qwen3.6-27b
GROQ_LINE_ASSIST_MODE=suspicious_only
GROQ_CONSENSUS_MODE=adaptive
GROQ_TIMEOUT_SECONDS=25
GROQ_POST_CORRECTION_ENABLED=true
GEMINI_ENABLED=true
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_ENABLED=false
GEMINI_POST_CORRECTION_ENABLED=true
CLOUD_ADVISOR_MAX_CONCURRENCY=3
