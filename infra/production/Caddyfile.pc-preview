{
    admin off
    auto_https off
}

:8080 {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    @public_api path /api/v1/* /actuator/health
    handle @public_api {
        reverse_proxy backend:8080
    }
    handle {
        respond 404
    }
}
