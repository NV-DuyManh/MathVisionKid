# ============================================================
# MathVision Kids -- Central Local Environment Configuration (.env.example)
# ============================================================
# Copy this file to individual service .env files or set environment
# variables directly for local development and demonstration.
#
# DO NOT COMMIT PRODUCTION SECRETS TO SOURCE CONTROL.
# ============================================================

# ------------------------------------------------------------
# 1. Spring Boot Business API (services/business-api)
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/mathvision
DB_USERNAME=mathvision
DB_PASSWORD=password123
JWT_SECRET=super_secret_development_jwt_key_do_not_use_in_production_1234567890
JWT_EXPIRATION=86400000
UPLOAD_ROOT=.data/uploads/
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# AI Gateway Integration (Spring -> FastAPI)
AI_GATEWAY_MODE=FASTAPI
AI_SERVICE_URL=http://localhost:8000/internal/v1/jobs
INTERNAL_API_KEY=secret-key-default

# Object Storage (MinIO S3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=mathvision

# ------------------------------------------------------------
# 2. FastAPI AI Runtime & Celery Worker (services/ai-service)
# ------------------------------------------------------------
APP_ENV=development
RUNTIME_MODE=FIXTURE
PORT=8000
HOST=0.0.0.0
REDIS_URL=redis://localhost:6379/0
SPRING_CALLBACK_BASE_URL=http://localhost:8080/internal/v1/ai/jobs

# Model Handoff (Leave empty in FIXTURE demo mode)
MODEL_MANIFEST_PATH=
MODEL_ARTIFACT_PATH=

# Object Storage Client (MinIO S3)
MINIO_SECURE=false

# ------------------------------------------------------------
# 3. Teacher Web Portal (teacher-web/.env)
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_USE_MOCK=false

# ------------------------------------------------------------
# 4. Student Mobile App (apps/student-mobile or root)
# ------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# Note: When testing on a physical Android device or emulator,
# replace 'localhost' with your development machine's LAN IP
# (or 10.0.2.2 for Android Studio Emulator).
