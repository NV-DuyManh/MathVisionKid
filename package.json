{
  "name": "mathvision-kids-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/student-mobile",
    "apps/teacher-web",
    "apps/admin-web",
    "apps/portal-web",
    "packages/*"
  ],
  "scripts": {
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report .local-artifacts/browser/report",
    "check:governance": "node scripts/skills.mjs check && node scripts/governance.mjs check && node --test scripts/governance.test.mjs scripts/git-flow.test.mjs",
    "start:device": "npm run start:device --workspace=student-mobile",
    "start:mobile": "npm run start:device --workspace=student-mobile",
    "test:mobile": "npm test --workspace=student-mobile",
    "lint:mobile": "npm run lint --workspace=student-mobile",
    "build:teacher": "npm run build --workspace=teacher-web",
    "build:admin": "npm run build --workspace=admin-web",
    "build:portal": "npm run build --workspace=portal-web",
    "build:web": "npm run build --workspaces --if-present"
  },
  "dependencies": {
    "expo": "~58.0.23"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1",
    "@firebase/app": "0.16.2",
    "shell-quote": "1.12.0",
    "follow-redirects": "1.16.2",
    "node-forge": "1.4.2",
    "source-map-js": "1.2.2",
    "vite": "8.3.5",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "expo-router": "58.0.30",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "glob": "14.0.2",
    "@react-native/jest-preset": {
      "glob": "7.2.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
