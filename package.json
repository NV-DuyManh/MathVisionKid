{
  "name": "mathvision-kids-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/student-mobile",
    "apps/teacher-web",
    "apps/admin-web",
    "apps/portal-web",
    "packages/*"
  ],
  "scripts": {
    "start:device": "npm run start:device --workspace=student-mobile",
    "start:mobile": "npm run start:device --workspace=student-mobile",
    "test:mobile": "npm test --workspace=student-mobile",
    "lint:mobile": "npm run lint --workspace=student-mobile",
    "build:teacher": "npm run build --workspace=teacher-web",
    "build:admin": "npm run build --workspace=admin-web",
    "build:portal": "npm run build --workspace=portal-web",
    "build:web": "npm run build --workspaces --if-present"
  }
}
