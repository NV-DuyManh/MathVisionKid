# Private AI API and Celery worker use the same production environment and models.
# Configure these values in the hosting platform's secret/environment settings.
# Never bake credentials or models into the image.
APP_ENV=production
RUNTIME_MODE=MODEL
PORT=8000
AI_HOST=0.0.0.0

# Redis URL may use rediss:// with managed Redis credentials.
REDIS_URL=redis://redis:6379/0
SPRING_CALLBACK_BASE_URL=http://backend:8080/internal/v1/ai/jobs
# Must equal the backend's internal API key. Generate a unique secret >=32 bytes.
INTERNAL_API_KEY=

# Backend and AI must share this private object store and bucket.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mathvision
MINIO_SECURE=false

# Mount the existing verified runtime model bundle read-only at /app/models.
# Detection: model_manifest.json, yolov8n_mathvision_det_v1.pt, label_map_detection.json
# Handwriting: ocr/crnn_vi_handwriting_v1/{best_cer.pth,vocab.json,model_manifest.json}
# Text detection: ocr/text_detection_cn_ppocrv3_2023may.onnx, ocr/text_detector_manifest.json
MODEL_MANIFEST_PATH=/app/models/model_manifest.json
MODEL_ARTIFACT_PATH=/app/models/yolov8n_mathvision_det_v1.pt
OCR_PROVIDER=crnn_vi_handwriting_v1
OCR_MODEL_DIR=/app/models/ocr/crnn_vi_handwriting_v1
OCR_DEVICE=cpu
OCR_BRIDGE_MODE=shadow
CANONICAL_RUNTIME_OVERRIDE_ENABLED=false
OCR_PHYSICAL_TRACE_ENABLED=false

# Real cloud advisors. Supply comma-separated secret keys for both providers.
# Model names match the runtime configuration; verify availability before release.
GROQ_ENABLED=true
GROQ_API_KEYS=
GROQ_PRIMARY_VISION_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_VISION_MODEL=qwen/qwen3.6-27b
GROQ_LINE_ASSIST_MODE=suspicious_only
GROQ_POST_CORRECTION_ENABLED=true
GROQ_ROTATE_ON_429=false
GEMINI_ENABLED=true
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_ENABLED=false
GEMINI_POST_CORRECTION_ENABLED=true
GEMINI_ROTATE_ON_429=false
CLOUD_ADVISOR_MAX_CONCURRENCY=3
HWTEXT_ALWAYS_REVIEW_ENABLED=true

# Run a separate worker from the same image (with the same environment/model mount):
# celery -A app.jobs.celery_app worker --loglevel=info --pool=solo --hostname=mathvision@%h
# Override the image healthcheck for workers with a targeted Celery ping.
# /health is API liveness; /ready verifies Redis, the detector model, and an active worker.
# Keep the AI API private; only the backend should reach /internal/v1 routes.
