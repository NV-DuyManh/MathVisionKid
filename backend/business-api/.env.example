# Local development only. Production requires generated secrets and HTTPS web origins.
SPRING_PROFILES_ACTIVE=dev
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/mathvision
DB_USERNAME=mathvision
DB_PASSWORD=mathvision_password
JWT_SECRET=super_secret_development_jwt_key_do_not_use_in_production
JWT_EXPIRATION=86400000
UPLOAD_ROOT=.data/uploads/
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5172,http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:5172,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8081
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=mathvision
AI_GATEWAY_MODE=FASTAPI
AI_SERVICE_URL=http://localhost:8000/internal/v1/jobs
AI_SERVICE_BASE_URL=http://localhost:8000
INTERNAL_API_KEY=secret-key-default

# Configure with real SMTP credentials to enable password reset emails.
# For Gmail, use smtp.gmail.com:587 and a Google App Password (not your account password).
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_FROM=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Google Identity Services web client. Use the same web client ID in the portal build.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# Optional native OAuth clients. Backend accepts these alongside the web client ID.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Verify Firebase Facebook ID tokens on the backend. Keep the service-account JSON outside Git.
FACEBOOK_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=mathvision-2f6a9
GOOGLE_APPLICATION_CREDENTIALS=
